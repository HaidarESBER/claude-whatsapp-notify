#!/bin/sh
# Claude Code with the WhatsApp channel. Location-independent: see claude-wa.js
# (resolves symlinks so it also works when copied or linked onto your PATH)
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
exec node "$(cd "$(dirname "$SELF")" && pwd)/claude-wa.js" "$@"
